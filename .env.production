VITE_ENV = production
# Standalone edition: no external backend. All API calls stay same-origin and
# are answered by the local mock routes in server/routes/x-blog/api/v1/.
VITE_NUXT_ORIGIN_URL =
VITE_NUXT_API_PREFIX = /x-blog/api/v1
VITE_NUXT_ADMIN_URL =
VITE_NUXT_PREFIX_PATH = ''
VITE_NUXT_OPEN_ENCRYPT = false
VITE_NUXT_GATEWAY_CRYPTO = aes
# No realtime backend in this edition
VITE_NUXT_USE_SOCKET_IO = false
